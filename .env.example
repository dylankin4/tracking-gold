# --- Telegram user account (https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+84...
# @username or numeric id like -1001234567890
SIGNAL_CHANNEL=

# --- MT5 ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional, needed if several terminals are installed
MT5_PATH=

# --- Orders ---
SIGNAL_SYMBOL=XAUUSD
SIGNAL_LOT_SIZE=0.01
SIGNAL_MAGIC=20260611
SIGNAL_EXPIRY_HOURS=24
# Take-profit ladder for every entry, as "profit:new SL" steps from the entry price.
# Each step closes SIGNAL_TP_LADDER_CLOSE_FRACTION of the lots still open and moves the SL to
# entry +/- new SL; the last step (no SL) closes the rest and is also the order's TP.
SIGNAL_TP_LADDER=5:0.3,10:6,15:12,20
SIGNAL_TP_LADDER_CLOSE_FRACTION=0.5
SIGNAL_MIN_SL_DISTANCE=5
SIGNAL_DEVIATION_POINTS=20
# Stop opening new trades once today's closed profit is above this (USD, 0 = off)
SIGNAL_DAILY_PROFIT_TARGET=150
# Stop opening new trades once today's closed loss reaches this (USD, 0 = off)
SIGNAL_DAILY_MAX_LOSS=500
# Ignore signals older than this many seconds
SIGNAL_MAX_AGE_SECONDS=120
