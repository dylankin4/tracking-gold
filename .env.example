# --- Telegram user account (https://my.telegram.org) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+84...
# @username or numeric id like -1001234567890
SIGNAL_CHANNEL=

# --- MT5 ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional, needed if several terminals are installed
MT5_PATH=

# --- Orders ---
SIGNAL_SYMBOL=XAUUSD
SIGNAL_LOT_SIZE=0.01
SIGNAL_MAGIC=20260611
SIGNAL_EXPIRY_HOURS=24
SIGNAL_TP_DISTANCE=7
SIGNAL_TP_DISTANCE_2=9
SIGNAL_MIN_SL_DISTANCE=5
SIGNAL_DEVIATION_POINTS=20
# Ignore signals older than this many seconds
SIGNAL_MAX_AGE_SECONDS=120
